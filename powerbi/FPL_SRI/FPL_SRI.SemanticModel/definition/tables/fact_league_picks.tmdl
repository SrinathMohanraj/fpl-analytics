	partition fact_league_picks = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl & "fact_league_picks.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"league_entry_key", type text},
				        {"league_id", Int64.Type},
				        {"entry_id", Int64.Type},
				        {"gameweek", Int64.Type},
				        {"player_id", Int64.Type},
