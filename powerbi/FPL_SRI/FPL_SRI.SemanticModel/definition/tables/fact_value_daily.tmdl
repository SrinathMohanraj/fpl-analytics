	partition fact_value_daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl & "fact_value_daily.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"snapshot_date", type date},
				        {"gameweek", Int64.Type},
				        {"squad_value", type number},
				        {"bank", type number},
				        {"team_value", type number},
				        {"value_change", type number},
				        {"players_rising", Int64.Type},
				        {"players_falling", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
