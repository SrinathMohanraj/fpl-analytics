	partition fact_price_daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl & "fact_price_daily.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"snapshot_date", type date},
				        {"gameweek", Int64.Type},
				        {"player_id", Int64.Type},
				        {"price_m", type number},
				        {"price_change", type number},
				        {"selected_by_percent", type number},
				        {"transfers_in_event", Int64.Type},
				        {"transfers_out_event", Int64.Type},
				        {"in_my_squad", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
