	partition fact_team_fixture = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl & "fact_team_fixture.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"gameweek", Int64.Type},
				        {"kickoff_time", type datetimezone},
				        {"finished", type logical},
				        {"team_id", Int64.Type},
				        {"opponent_id", Int64.Type},
				        {"is_home", type logical},
				        {"difficulty", Int64.Type},
				        {"goals_for", Int64.Type},
				        {"goals_against", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
