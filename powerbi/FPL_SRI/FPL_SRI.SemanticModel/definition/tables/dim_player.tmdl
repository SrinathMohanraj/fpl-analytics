	partition dim_player = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl & "dim_player.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"player_id", Int64.Type},
				        {"web_name", type text},
				        {"full_name", type text},
				        {"team_id", Int64.Type},
				        {"position", type text},
				        {"price_m", type number},
				        {"selected_by_percent", type number},
				        {"form", type number},
				        {"total_points", Int64.Type},
				        {"status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
